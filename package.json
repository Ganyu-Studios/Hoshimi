{
    "name": "hoshimi",
    "version": "0.5.0",
    "description": "A lavalink@v4 client easy to use, up-to-date and all ears.",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
    "exports": {
        ".": {
            "types": "./dist/index.d.cts",
            "require": "./dist/index.cjs",
            "import": "./dist/index.mjs",
            "default": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "lint-staged": {
        "*.{ts,json}": [
            "pnpm format"
        ]
    },
    "repository": {
        "url": "https://github.com/Ganyu-Studios/Hoshimi.git",
        "type": "git"
    },
    "scripts": {
        "build": "pnpm typecheck && tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "prepare": "husky && pnpm build"
    },
    "keywords": [
        "discord",
        "lavalink",
        "lavalink-v4",
        "discord",
        "distube",
        "music-bot",
        "lavalink-player",
        "lavalink-client",
        "music"
    ],
    "author": "Ganyu Studios",
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/node": "^26.1.2",
        "@types/ws": "^8.18.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "ws": "^8.21.1"
    }
}
